    {
      "parameters": {
        "functionCode": "const pincode = $json.pincode;\n\nlet address_risk = \"LOW\";\n\nif (!pincode) {\n  address_risk = \"UNKNOWN\";\n} else if ([\"560001\"].includes(pincode)) {\n  address_risk = \"LOW\";\n} else {\n  address_risk = \"HIGH\";\n}\n\nreturn [{\n  ...$json,\n  address_risk\n}];\n"
      },
      "id": "dcfd78af-ce68-4b97-a303-b112d8798b48",
      "name": "Address Risk Engine",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -624,
        -16
      ]
    },
    {
      "parameters": {
        "functionCode": "for (const item of items) {\n  const paymentMethod = item.json.body.payment_method;\n  const orderValue = item.json.body.order_value;\n\n  if (paymentMethod === \"COD\" && orderValue > 1000) {\n    item.json.payment_risk = \"HIGH\";\n  } else if (paymentMethod === \"COD\") {\n    item.json.payment_risk = \"MEDIUM\";\n  } else {\n    item.json.payment_risk = \"LOW\";\n  }\n}\n\nreturn items;\n"
      },
      "id": "b6d4ec52-6352-4329-8040-f7575b428821",
      "name": "Payment Anomaly Engine",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -272,
        -16
      ]
    },
    {
      "parameters": {
        "functionCode": "for (const item of items) {\n  const slaHours = item.json.body.delivery_sla_hours;\n\n  if (slaHours <= 24) {\n    item.json.sla_risk = \"LOW\";\n  } else if (slaHours <= 48) {\n    item.json.sla_risk = \"MEDIUM\";\n  } else {\n    item.json.sla_risk = \"HIGH\";\n  }\n}\n\nreturn items;\n"
      },
      "id": "2b578597-6df3-413b-bc94-bde2c35353fc",
      "name": "SLA Prediction Engine",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -624,
        272
      ]
    },
    {
      "parameters": {
        "functionCode": "for (const item of items) {\n  const paymentMethod = item.json.body.payment_method;\n  const orderValue = item.json.body.order_value;\n\n  if (paymentMethod === \"COD\" && orderValue > 1000) {\n    item.json.fraud_risk = \"HIGH\";\n  } else if (paymentMethod === \"COD\") {\n    item.json.fraud_risk = \"MEDIUM\";\n  } else {\n    item.json.fraud_risk = \"LOW\";\n  }\n}\n\nreturn items;\n"
      },
      "id": "b3009360-7fe2-4e74-a0ca-38b6e49a070d",
      "name": "RTO / Fraud Risk Engine",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -256,
        272
      ]
    },
    {
      "parameters": {},
      "id": "17d87c40-fa0f-4b7d-aabd-5a20ec2c010f",
      "name": "Merge Risk Engines",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        608,
        -496
      ],
      "disabled": true
    },
    {
      "parameters": {
        "functionCode": "for (const item of items) {\n  const risks = [\n    item.json.address_risk,\n    item.json.payment_risk,\n    item.json.sla_risk,\n    item.json.fraud_risk,\n  ];\n\n  if (risks.includes(\"HIGH\")) {\n    item.json.exception_type = \"CRITICAL\";\n    item.json.exception_severity = \"HIGH\";\n  } else if (risks.includes(\"MEDIUM\")) {\n    item.json.exception_type = \"WARNING\";\n    item.json.exception_severity = \"MEDIUM\";\n  } else {\n    item.json.exception_type = \"NORMAL\";\n    item.json.exception_severity = \"LOW\";\n  }\n}\n\nreturn items;\n"
      },
