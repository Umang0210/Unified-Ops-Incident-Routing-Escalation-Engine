    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nlet assigned_team = \"OPS\";\n\nif ($json.payment_risk === \"HIGH\") {\n  assigned_team = \"FINANCE\";\n} else if ($json.address_risk === \"HIGH\") {\n  assigned_team = \"ADDRESS\";\n} else if ($json.sla_risk === \"HIGH\") {\n  assigned_team = \"SLA\";\n} else if ($json.fraud_risk === \"HIGH\") {\n  assigned_team = \"FRAUD\";\n}\n\nconst slaHours = 2;\nconst slaDeadline = new Date(now.getTime() + slaHours * 60 * 60 * 1000);\n\nreturn [{\n  // 👇 ONLY business fields\n  order_id: $json.body.order_id,\n  customer_id: $json.body.customer_id,\n  payment_method: $json.body.payment_method,\n  order_value: $json.body.order_value,\n\n  pincode: $json.body.address?.pincode,\n  city: $json.body.address?.city,\n  state: $json.body.address?.state,\n\n  address_risk: $json.address_risk,\n  payment_risk: $json.payment_risk,\n  sla_risk: $json.sla_risk,\n  fraud_risk: $json.fraud_risk,\n\n  exception_type: $json.exception_type,\n  exception_severity: $json.exception_severity,\n\n  assigned_team,\n  status: \"OPEN\",\n  created_at: now.toISOString(),\n  sla_deadline: slaDeadline.toISOString()\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        160
      ],
